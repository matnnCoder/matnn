var a = 10;
var b = 3;

Console.log("算术运算符:");
Console.log("a + b =", a + b);
Console.log("a - b =", a - b);
Console.log("a * b =", a * b);
Console.log("a / b =", a / b);
Console.log("a % b =", a % b);

Console.log("\n比较运算符:");
Console.log("a == b:", a == b);
Console.log("a != b:", a != b);
Console.log("a < b:", a < b);
Console.log("a > b:", a > b);

Console.log("\n逻辑运算符:");
Console.log("true && false:", true && false);
Console.log("true || false:", true || false);
Console.log("!true:", !true);

Console.log("\n自增运算符:");
var i = 0;
Console.log("i++ =", i++);
Console.log("i =", i);
